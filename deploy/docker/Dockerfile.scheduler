FROM maven:3.9.8-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml ./
COPY scraper-common ./scraper-common
COPY scraper-api ./scraper-api
COPY scraper-worker ./scraper-worker
COPY scraper-scheduler ./scraper-scheduler
RUN mvn -q -pl scraper-scheduler -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/scraper-scheduler/target/scraper-scheduler-1.0.0.jar app.jar
EXPOSE 8082
ENTRYPOINT ["java","-jar","/app/app.jar"]
